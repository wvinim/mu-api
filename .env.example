# ==== Servidor ====
PORT=3000
NODE_ENV=development
# Nº de proxies reversos na frente da API. Produção atrás do nginx: 1.
# Deixe 0 se a API for acessada direto (senão o IP do cliente pode ser forjado).
TRUST_PROXY=0

# ==== Banco de dados (SQL Server - mesmo banco do gameserver) ====
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MuOnline
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ==== JWT ====
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ==== SMTP (e-mail próprio) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nome do Servidor <noreply@seudominio.com>"
# Assinatura DKIM feita pela API (ver docs/EMAIL_DKIM.md). Preencha as três
# ou deixe as três vazias. Gere o par de chaves com `npm run generate-dkim-key`.
# A chave privada NUNCA vai para o repositório.
# Ex: DKIM_DOMAIN=mupro.vip / DKIM_SELECTOR=api / DKIM_PRIVATE_KEY_PATH=/home/<usuario>/mu-api-secrets/dkim-api.pem
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY_PATH=

# ==== Efí (Gerencianet) — API Pix ====
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_SANDBOX=true
# Caminho local do certificado .p12 (baixado no painel da Efí em
# API > Meus Certificados). NUNCA versionar esse arquivo.
EFI_CERTIFICATE_PATH=
# Segredo usado como parte da URL do webhook (/shop/payment/webhook/:secret)
# para dificultar chamadas forjadas ao endpoint — ver docs/SECTION_5_SHOP.md
# sobre por que isso não substitui a verificação de status via API.
EFI_WEBHOOK_SECRET=
# Chave Pix cadastrada na conta Efí que vai receber os pagamentos.
EFI_PIX_KEY=
EFI_CHARGE_EXPIRATION_SECONDS=3600

# ==== CORS ====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==== Rate limit ====
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MINUTES=60
RATE_LIMIT_RESEND_CONFIRMATION_MAX=3
RATE_LIMIT_RESEND_CONFIRMATION_WINDOW_MINUTES=60
RATE_LIMIT_PURCHASE_MAX=1
RATE_LIMIT_PURCHASE_WINDOW_SECONDS=3
RATE_LIMIT_TICKET_CREATE_MAX=5
RATE_LIMIT_TICKET_CREATE_WINDOW_MINUTES=60

# ==== Site / e-mails ====
# Usado para montar os links de confirmação de e-mail e reset de senha
# enviados por e-mail (o front-end ainda não existe nesta sessão).
APP_URL=http://localhost:5173
EMAIL_CONFIRM_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# ==== Ranking de personagens ====
RANKING_CACHE_TTL_SECONDS=180

# ==== Status do servidor ====
# playersOnline = contas com MEMB_STAT.ConnectStat = 1 (ver docs/SECTION_8_SERVER.md).
SERVER_STATUS_CACHE_TTL_SECONDS=15
# Metadados estáticos para GET /api/v1/server/info (opcional, sem tabela no banco)
SERVER_NAME=
SERVER_SEASON=Season 2.5
SERVER_EXP_RATE=
SERVER_DROP_RATE=
SERVER_MAX_RESETS=

# ==== Papéis (staff/admin) ====
# Lista de usernames (memb___id) separados por vírgula. Decisão tomada com
# o usuário: ctl1_code não é usado para isso neste core (fica sempre 0).
ADMIN_USERNAMES=
STAFF_USERNAMES=
